# Copy into this project's ignored root .env. Never commit real credentials.
ENVIRONMENT=dev-monica
# Generate a NEW independent signing key: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZYX_FLASK_SECRET_KEY=
ZYX_REDIS_URL=redis://127.0.0.1:6390/0
ZYX_CELERY_QUEUE=zyx-agentic-llms.dev
OPENAI_API_KEY=
MODEL_PROVIDER=openai
# Server-only policy for newly admitted requests; not a frontend option.
WORKSPACE_DEFAULT_MODE=fast
WORKSPACE_FAST_MODEL=gpt-6-luna
WORKSPACE_DEEP_MODEL=gpt-6.1-sol
WORKSPACE_LEGAL_ENABLED=1
FREE_LAW_API_TOKEN=
# Optional: absolute SQLite URL inside THIS project's instance/ directory.
# ZYX_DATABASE_URL=sqlite:////absolute/path/to/zyx-agentic-llms/instance/zyx-agentic-llms.db
# Cloud OCR reads ONLY .private/aws/credentials profile [workspace].
# ZYX_AWS_REGION=us-east-1
# AGENT_PYTHON_IMAGE=zyx-agentic-llms-python-analysis:1
